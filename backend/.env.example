APP_ENV=development
APP_DEBUG=true

# ============================================================
# Koneksi Database - Supabase (PostgreSQL)
# Ambil nilai-nilai ini dari: Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
# Gunakan mode "Session pooler" (port 5432) untuk backend PHP tradisional seperti Slim,
# BUKAN "Transaction pooler" (port 6543) - PDO prepared statement kurang cocok dengan mode transaction pgbouncer.
# ============================================================
DB_DRIVER=pgsql
DB_HOST=aws-0-REGION.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.PROJECT_REF
DB_PASSWORD=YOUR_DB_PASSWORD
DB_SSLMODE=require

# Kunci JWT: generate acak panjang via `openssl rand -base64 32`
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRY_SECONDS=3600
JWT_REFRESH_EXPIRY_SECONDS=1209600

# Kunci enkripsi payload sync (AES-256-GCM): generate via `openssl rand -base64 32`
SYNC_ENCRYPTION_KEY=CHANGE_THIS_TO_32_BYTE_KEY_BASE64

# Origin frontend yang diizinkan (kosongkan / set '*' bila backend & frontend same-origin di balik nginx)
CORS_ALLOWED_ORIGIN=http://localhost:5173
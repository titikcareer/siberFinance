{
    "name": "yourcompany/finance-app-backend",
    "description": "Backend API - Personal Finance Management (Slim Framework)",
    "type": "project",
    "require": {
        "php": "^8.1",
        "slim/slim": "^4.12",
        "slim/psr7": "^1.6",
        "php-di/php-di": "^7.0",
        "firebase/php-jwt": "^7.0",
        "vlucas/phpdotenv": "^5.6",
        "respect/validation": "^2.3",
        "monolog/monolog": "^3.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "scripts": {
        "start": "php -S localhost:8080 -t public public/index.php"
    }
}
